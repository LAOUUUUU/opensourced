[Unit]
Description=Barely-free node agent
After=network.target wg-quick@wg0.service
Wants=wg-quick@wg0.service

[Service]
Type=simple
ExecStart=/usr/local/bin/bf-agent
Restart=on-failure
RestartSec=2

# Settings (specs/agent.md). The secret stays root-only on disk; systemd hands the service
# a private copy.
Environment=BF_LISTEN=127.0.0.1:9870
Environment=BF_INTERFACE=wg0
Environment=BF_WG_BIN=/usr/bin/wg
Environment=BF_STATE_DIR=/var/lib/barely-free
Environment=BF_SECRET_FILE=%d/agent.secret
LoadCredential=agent.secret:/etc/barely-free/agent.secret

# A throwaway user that may change WireGuard and nothing else.
DynamicUser=yes
StateDirectory=barely-free
StateDirectoryMode=0700
UMask=0077
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# The agent only ever talks to localhost.
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
