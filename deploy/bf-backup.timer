[Unit]
Description=Barely-free nightly backup of the accounts database

[Timer]
# 03:30 in Toronto in winter (04:30 in summer), give or take half an hour. A night missed
# while the VM was off runs at the next boot.
OnCalendar=*-*-* 08:30:00 UTC
RandomizedDelaySec=30min
Persistent=true

[Install]
WantedBy=timers.target
